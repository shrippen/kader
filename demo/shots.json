{
  "kind": "web",
  "start": "demo/start.sh --no-browser --port {port}",
  "ready_line": "^(http://127\\.0\\.0\\.1:\\d+/\\?t=\\S+)",
  "viewport": [
    1400,
    1000
  ],
  "setup": [
    {
      "goto": "{base}"
    },
    {
      "eval": "localStorage.setItem('shrippen-lang', '{lang}')"
    },
    {
      "goto": "{base}"
    },
    {
      "wait": "#bands .tile"
    },
    {
      "eval": "new Promise(r => { const t = setInterval(() => { if (document.querySelector('#phase-pill .pill')?.dataset.state === 'reviewing') { clearInterval(t); r(); } }, 300); })"
    }
  ],
  "shots": [
    {
      "name": "gallery",
      "actions": [
        {
          "eval": "window.scrollTo(0, document.querySelector('#bands').getBoundingClientRect().top + window.scrollY - 90)"
        }
      ],
      "settle": 1500
    },
    {
      "name": "editor",
      "actions": [
        {
          "dblclick": "#bands .band[data-tier='green'] .tile"
        },
        {
          "wait": "#editor:not([hidden]) #ed-crop"
        },
        {
          "sleep": 1200
        }
      ]
    }
  ],
  "page": {
    "placeholder-labels.svg": "gallery",
    "placeholder-strategies.svg": "editor"
  },
  "note": "docs/shots/before-after.webp is made by 'demo/rolls.py before-after docs/shots/before-after.webp' (language-neutral, real detection on a demo roll). The darktable panel stays a placeholder: it needs darktable's GUI with the plugin."
}
